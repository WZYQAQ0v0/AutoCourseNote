{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/course-note-agents/phase4.reviewed_document.schema.json",
  "title": "Course Note Agents Phase 4 Reviewed Document",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "language",
    "source",
    "reviewer",
    "title",
    "revised_markdown",
    "findings",
    "supplements",
    "remaining_open_issues",
    "evidence_refs",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "phase4.reviewed_document.v1" },
    "course_id": { "type": "string" },
    "language": { "type": "string" },
    "source": { "type": "object" },
    "reviewer": { "type": "object" },
    "title": { "type": "string" },
    "revised_markdown": { "type": "string" },
    "findings": { "type": "array" },
    "supplements": { "type": "array", "items": { "type": "string" } },
    "remaining_open_issues": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
