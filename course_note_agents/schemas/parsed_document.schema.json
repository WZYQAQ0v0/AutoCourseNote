{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/course-note-agents/phase2.parsed_document.schema.json",
  "title": "Course Note Agents Phase 2 Parsed Document",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "language",
    "file",
    "parser",
    "parse_status",
    "pages",
    "chunks",
    "linear_text",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "phase2.parsed_document.v1"
    },
    "course_id": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "file": {
      "type": "object"
    },
    "parser": {
      "type": "object"
    },
    "parse_status": {
      "enum": ["success", "success_with_warnings", "requires_ocr", "empty"]
    },
    "pages": {
      "type": "array"
    },
    "chunks": {
      "type": "array"
    },
    "linear_text": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
