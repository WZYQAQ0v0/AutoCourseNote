{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/course-note-agents/phase2.parsed_index.schema.json",
  "title": "Course Note Agents Phase 2 Parsed Index",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "language",
    "generated_at",
    "manifest_ref",
    "parsed_documents_dir",
    "counts",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "phase2.parsed_index.v1"
    },
    "course_id": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "manifest_ref": {
      "type": "string"
    },
    "parsed_documents_dir": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "documents": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
