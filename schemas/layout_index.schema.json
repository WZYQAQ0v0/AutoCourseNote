{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/course-note-agents/phase7.layout_index.schema.json",
  "title": "Course Note Agents Phase 7 Layout Index",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "language",
    "generated_at",
    "source_index_ref",
    "source_markdown_ref",
    "tex_ref",
    "compile_status",
    "counts"
  ],
  "properties": {
    "schema_version": { "const": "phase7.layout_index.v1" },
    "course_id": { "type": "string" },
    "language": { "type": "string" },
    "generated_at": { "type": "string" },
    "source_index_ref": { "type": "string" },
    "source_markdown_ref": { "type": "string" },
    "tex_ref": { "type": "string" },
    "pdf_ref": { "type": ["string", "null"] },
    "compile_status": { "type": "string" },
    "compile_log_ref": { "type": ["string", "null"] },
    "counts": { "type": "object" }
  },
  "additionalProperties": false
}
